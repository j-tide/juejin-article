      "type": "backend",
      "label": "开启写事务",
      "sublabel": "BEGIN IMMEDIATE",
      "width": 178
    },
    {
      "id": "version",
      "lane": "main",
      "col": 1,
      "type": "security",
      "label": "检查预期版本",
      "sublabel": "拒绝过期执行者",
      "width": 178
    },
    {
      "id": "write",
      "lane": "main",
      "col": 2,
