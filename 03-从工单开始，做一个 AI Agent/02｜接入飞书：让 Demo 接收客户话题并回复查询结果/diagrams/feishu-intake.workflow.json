{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "飞书入口：接单、调查与回复分开执行",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "intake",
      "label": "接收回调"
    },
    {
