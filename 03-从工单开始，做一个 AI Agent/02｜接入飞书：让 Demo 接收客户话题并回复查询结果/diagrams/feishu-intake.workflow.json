      "width": 164
    },
    {
      "id": "scope",
      "lane": "intake",
      "col": 1,
      "type": "security",
      "label": "核对应用和门店",
      "sublabel": "忽略机器人 · 绑定群",
      "width": 164
    },
    {
      "id": "inbox",
      "lane": "intake",
      "col": 2,
      "type": "database",
      "label": "持久化 Inbox",
      "sublabel": "事件与消息双重去重",
      "width": 164
    },
    {
      "id": "worker",
      "lane": "work",
      "col": 2,
      "type": "backend",
      "label": "后台调查",
      "sublabel": "调用第 01 篇执行器",
      "width": 164
    },
    {
      "id": "outbox",
      "lane": "work",
      "col": 3,
