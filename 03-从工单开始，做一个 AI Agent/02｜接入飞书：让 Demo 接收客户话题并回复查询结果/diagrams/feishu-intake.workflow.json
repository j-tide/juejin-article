      "sublabel": "稳定 UUID · 指定根消息",
      "width": 164
    },
    {
      "id": "receipt",
      "lane": "delivery",
      "col": 4,
      "type": "backend",
      "label": "检查发送结果",
      "sublabel": "平台消息 ID / 不确定",
      "width": 164
    },
    {
      "id": "state",
      "lane": "delivery",
      "col": 5,
      "type": "frontend",
      "label": "保留交付状态",
      "sublabel": "不确定时停止自动重发",
      "width": 164
    }
  ],
  "edges": [
    {
      "id": "event-scope",
      "from": "event",
      "to": "scope"
    },
    {
      "id": "scope-inbox",
      "from": "scope",
      "to": "inbox"
    },
    {
      "id": "inbox-worker",
      "from": "inbox",
      "to": "worker"
    },
    {
      "id": "worker-outbox",
      "from": "worker",
      "to": "outbox"
    },
    {
      "id": "outbox-sending",
      "from": "outbox",
      "to": "sending"
    },
    {
      "id": "sending-receipt",
      "from": "sending",
      "to": "receipt"
    },
    {
      "id": "receipt-state",
      "from": "receipt",
      "to": "state"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "收到消息和完成调查是两件事",
      "items": [
        "回调只负责入库；模型请求放到后台 Worker。"
      ]
    },
    {
      "dot": "amber",
      "title": "发送超时不等于没有发送",
      "items": [
        "保留 uncertain 状态；核对平台消息后再决定下一步。"
      ]
    }
