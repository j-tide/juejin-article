    },
    {
      "id": "scope",
      "lane": "input",
      "col": 1,
      "type": "security",
      "label": "先限定可读资料",
      "sublabel": "品牌 · 门店 · 有效期",
      "width": 164
    },
    {
      "id": "retrieve",
      "lane": "input",
      "col": 2,
