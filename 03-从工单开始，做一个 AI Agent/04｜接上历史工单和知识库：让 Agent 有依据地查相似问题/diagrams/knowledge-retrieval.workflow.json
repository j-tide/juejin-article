    },
    {
      "id": "scope-retrieve",
      "from": "scope",
      "to": "retrieve"
    },
    {
      "id": "retrieve-rank",
      "from": "retrieve",
      "to": "rank"
    },
    {
      "id": "rank-conditions",
      "from": "rank",
      "to": "conditions"
    },
    {
      "id": "conditions-conflict",
      "from": "conditions",
      "to": "conflict"
    },
    {
